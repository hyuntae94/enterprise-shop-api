# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Enterprise Shop API"
ENVIRONMENT=local           # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_JSON=false              # true in production for structured logs

# CORS (comma-separated origins, or * for all in local)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# ---------------------------------------------------------------------------
# Database (async PostgreSQL)
# ---------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=shop
POSTGRES_PASSWORD=shop
POSTGRES_DB=shop
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ---------------------------------------------------------------------------
# Redis (cache + arq task queue)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
